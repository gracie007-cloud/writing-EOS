# Secrets: keys live in .env only and never leave this computer.
.env
**/.env

# The real answer key is never read by a model and never stored here.
# (The blank template in docs/ and the fake key in tests/fixtures/ are not the real key.)
**/data/*ANSWER_KEY*

# The Author's library pools. The Obsidian vault is their master copy.
library/

# The Author's own list of private names, read by tools/check_public.py:
.private-words.txt

# Built from the files above; not sources.
Writing-EOS-App/
*.zip

# The harness's earlier stand-alone history, kept as a backup:
eos-bakeoff/.harness-local-history.git/

# Python leftovers
__pycache__/
*.pyc
.pytest_cache/
